---
import Layout from "@/layouts/Layout.astro";
import { createClient } from "@/lib/supabase";
import type { Match, Prediction, Tournament } from "@/types";

const { user, role } = Astro.locals;
const error = Astro.url.searchParams.get("error");

const supabase = createClient(Astro.request.headers, Astro.cookies);

let tournaments: Tournament[] = [];
const matchesByTournament = new Map<string, Match[]>();
const predictionByMatch = new Map<string, Prediction>();

if (supabase && user) {
  const { data: tournamentData } = await supabase
    .from("tournaments")
    .select("*")
    .overrideTypes<Tournament[], { merge: false }>();
  tournaments = (tournamentData ?? []).sort((a, b) => {
    if (a.status !== b.status) return a.status === "active" ? -1 : 1;
    return b.created_at.localeCompare(a.created_at);
  });

  const tournamentIds = tournaments.map((t) => t.id);
  if (tournamentIds.length > 0) {
    const { data: matchData } = await supabase
      .from("matches")
      .select("*")
      .in("tournament_id", tournamentIds)
      .order("scheduled_at", { ascending: true })
      .overrideTypes<Match[], { merge: false }>();

    for (const match of matchData ?? []) {
      const list = matchesByTournament.get(match.tournament_id) ?? [];
      list.push(match);
      matchesByTournament.set(match.tournament_id, list);
    }

    const matchIds = (matchData ?? []).map((m) => m.id);
    if (matchIds.length > 0) {
      const { data: predictionData } = await supabase
        .from("predictions")
        .select("*")
        .eq("user_id", user.id)
        .in("match_id", matchIds)
        .overrideTypes<Prediction[], { merge: false }>();
      for (const prediction of predictionData ?? []) {
        predictionByMatch.set(prediction.match_id, prediction);
      }
    }
  }
}

const now = new Date();

// scheduled_at is stored as a literal timestamp (see S-03 plan.md) — format
// via the raw ISO string, never toLocaleString(), same convention as the
// admin matches page.
function formatScheduledAt(iso: string) {
  return iso.slice(0, 16).replace("T", " ");
}
---

<Layout title="Dashboard">
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <div class="w-full max-w-2xl rounded-2xl border border-white/10 bg-white/10 p-8 text-white backdrop-blur-xl">
      <h1 class="mb-4 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent">
        Dashboard
      </h1>
      <p class="mb-6 text-sm text-blue-100/70">
        Zalogowano jako <span class="font-semibold text-white">{user?.email}</span>
      </p>

      {
        error && (
          <p class="mb-4 flex items-center gap-2 rounded-lg border border-red-500/30 bg-red-900/30 px-3 py-2 text-sm text-red-300">
            {error}
          </p>
        )
      }

      {
        tournaments.length === 0 ? (
          <p class="text-sm text-blue-100/60">Brak turniejów</p>
        ) : (
          <div class="space-y-6">
            {tournaments.map((tournament) => {
              const matches = matchesByTournament.get(tournament.id) ?? [];
              return (
                <div class="rounded-xl border border-white/10 bg-white/5 p-4">
                  <div class="mb-3 flex items-center justify-between">
                    <h2 class="text-lg font-semibold">{tournament.name}</h2>
                    <span class="text-xs text-blue-100/50 uppercase">{tournament.status}</span>
                  </div>
                  {matches.length === 0 ? (
                    <p class="text-sm text-blue-100/60">Brak spotkań</p>
                  ) : (
                    <ul class="space-y-3">
                      {matches.map((match) => {
                        const prediction = predictionByMatch.get(match.id);
                        const canPredict =
                          role === "user" && tournament.status === "active" && new Date(match.scheduled_at) > now;
                        return (
                          <li class="rounded-lg border border-white/10 bg-white/5 p-3">
                            <div class="mb-2 flex items-center justify-between text-sm">
                              <span>
                                {match.home_team} vs {match.away_team}
                              </span>
                              <span class="text-blue-100/50">{formatScheduledAt(match.scheduled_at)}</span>
                            </div>
                            {canPredict ? (
                              <form
                                method="POST"
                                action={`/api/matches/${match.id}/predictions`}
                                class="flex items-end gap-2"
                              >
                                <div>
                                  <label for={`home-${match.id}`} class="mb-1 block text-xs text-blue-100/70">
                                    {match.home_team}
                                  </label>
                                  <input
                                    id={`home-${match.id}`}
                                    name="predicted_home_score"
                                    type="number"
                                    min="0"
                                    required
                                    value={prediction?.predicted_home_score ?? ""}
                                    class="w-16 rounded-lg border border-white/20 bg-white/10 px-2 py-1 text-center text-white focus:ring-2 focus:ring-purple-400 focus:outline-none"
                                  />
                                </div>
                                <span class="pb-1.5">:</span>
                                <div>
                                  <label for={`away-${match.id}`} class="mb-1 block text-xs text-blue-100/70">
                                    {match.away_team}
                                  </label>
                                  <input
                                    id={`away-${match.id}`}
                                    name="predicted_away_score"
                                    type="number"
                                    min="0"
                                    required
                                    value={prediction?.predicted_away_score ?? ""}
                                    class="w-16 rounded-lg border border-white/20 bg-white/10 px-2 py-1 text-center text-white focus:ring-2 focus:ring-purple-400 focus:outline-none"
                                  />
                                </div>
                                <button
                                  type="submit"
                                  class="rounded-lg bg-purple-600 px-3 py-1.5 text-sm font-medium text-white transition-colors hover:bg-purple-500"
                                >
                                  {prediction ? "Zaktualizuj typ" : "Zapisz typ"}
                                </button>
                              </form>
                            ) : (
                              <p class="text-sm text-blue-100/70">
                                {prediction
                                  ? `Twój typ: ${prediction.predicted_home_score}:${prediction.predicted_away_score}`
                                  : "Brak typu"}
                              </p>
                            )}
                          </li>
                        );
                      })}
                    </ul>
                  )}
                </div>
              );
            })}
          </div>
        )
      }

      <form method="POST" action="/api/auth/signout" class="mt-6">
        <button
          type="submit"
          class="rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm transition-colors hover:bg-white/20"
        >
          Sign out
        </button>
      </form>
    </div>
  </div>
</Layout>

