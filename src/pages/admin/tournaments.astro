---
import Layout from "@/layouts/Layout.astro";
import { createClient } from "@/lib/supabase";
import type { Tournament } from "@/types";

const error = Astro.url.searchParams.get("error");

const supabase = createClient(Astro.request.headers, Astro.cookies);
let tournaments: Tournament[] = [];

if (supabase) {
  const { data } = await supabase
    .from("tournaments")
    .select("*")
    .order("created_at", { ascending: false })
    .overrideTypes<Tournament[], { merge: false }>();
  tournaments = data ?? [];
}
---

<Layout title="Turnieje">
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <div class="w-full max-w-lg rounded-2xl border border-white/10 bg-white/10 p-8 text-white backdrop-blur-xl">
      <h1 class="mb-6 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent">
        Turnieje
      </h1>

      {
        error && (
          <p class="mb-4 flex items-center gap-2 rounded-lg border border-red-500/30 bg-red-900/30 px-3 py-2 text-sm text-red-300">
            {error}
          </p>
        )
      }

      <form method="POST" action="/api/admin/tournaments" class="mb-8 space-y-4">
        <div>
          <label for="name" class="mb-1 block text-sm text-blue-100/80">Nazwa</label>
          <input
            id="name"
            name="name"
            type="text"
            required
            class="w-full rounded-lg border border-white/20 bg-white/10 px-3 py-2 text-white placeholder-white/40 focus:ring-2 focus:ring-purple-400 focus:outline-none"
            placeholder="np. Mistrzostwa Świata 2026"
          />
        </div>
        <div>
          <label for="description" class="mb-1 block text-sm text-blue-100/80">Opis (opcjonalnie)</label>
          <textarea
            id="description"
            name="description"
            rows="3"
            class="w-full rounded-lg border border-white/20 bg-white/10 px-3 py-2 text-white placeholder-white/40 focus:ring-2 focus:ring-purple-400 focus:outline-none"
            placeholder="Krótki opis turnieju"></textarea>
        </div>
        <button
          type="submit"
          class="w-full rounded-lg bg-purple-600 px-4 py-2 font-medium text-white transition-colors hover:bg-purple-500"
        >
          Załóż turniej
        </button>
      </form>

      <h2 class="mb-3 text-lg font-semibold">Lista turniejów</h2>
      {
        tournaments.length === 0 ? (
          <p class="text-blue-100/50">Brak turniejów</p>
        ) : (
          <ul class="space-y-3">
            {tournaments.map((tournament) => (
              <li class="rounded-lg border border-white/10 bg-white/5 p-4">
                <div class="flex items-center justify-between">
                  <span class="font-semibold">{tournament.name}</span>
                  <span class="rounded-full bg-white/10 px-2 py-0.5 text-xs uppercase">{tournament.status}</span>
                </div>
                {tournament.description && <p class="mt-1 text-sm text-blue-100/70">{tournament.description}</p>}
                <p class="mt-2 text-xs text-blue-100/40">
                  Utworzono: {new Date(tournament.created_at).toLocaleString()}
                </p>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </div>
</Layout>
