---
import Layout from "@/layouts/Layout.astro";

const { user } = Astro.locals;
---

<Layout title="Admin">
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <div
      class="w-full max-w-sm rounded-2xl border border-white/10 bg-white/10 p-8 text-center text-white backdrop-blur-xl"
    >
      <h1 class="mb-4 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
        Admin
      </h1>
      <p class="mb-6 text-blue-100/80">
        Signed in as admin: <span class="font-semibold text-white">{user?.email}</span>
      </p>
      <nav class="flex flex-col gap-3">
        <a
          href="/admin/tournaments"
          class="rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm transition-colors hover:bg-white/20"
        >
          Turnieje
        </a>
      </nav>
    </div>
  </div>
</Layout>
